  // ---------------- file export (works in artifact viewer and standalone) ----------------
  async function saveFile(filename, mime, content){
    try{
      if(window.claude && window.claude.use){
        const downloads = await window.claude.use("downloads");
        if(downloads){ await downloads.save({filename, data: content}); return; }
      }
    }catch(e){ /* fall through to browser download */ }
    const blob = content instanceof Blob ? content : new Blob([content], {type: mime});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=> URL.revokeObjectURL(url), 4000);
  }

  function csvEscape(v){
    const s = String(v==null?"":v);
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g,'""') + '"' : s;
  }

  // ---------------- image compression ----------------
  function compressImage(file, maxDim, quality){
    return new Promise((resolve, reject)=>{
      const img = new Image();
      const reader = new FileReader();
      reader.onload = e => { img.onload = ()=>{
        let {width, height} = img;
        if(width > height && width > maxDim){ height = height*maxDim/width; width = maxDim; }
        else if(height > maxDim){ width = width*maxDim/height; height = maxDim; }
        const canvas = document.createElement("canvas");
        canvas.width = width; canvas.height = height;
        canvas.getContext("2d").drawImage(img, 0, 0, width, height);
        resolve(canvas.toDataURL("image/jpeg", quality));
      }; img.onerror = reject; img.src = e.target.result; };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  // ================= ROSTER TAB =================
  function classById(id){ return state.data.classes.find(c=>c.id===id); }
  function studentsInClass(id){ return state.data.students.filter(s=> id === "__none" ? !s.classId : s.classId === id); }

  function classAttendanceRate(studentId, classId, lastN){
    const sessions = state.data.attendance.filter(a=>a.classId===classId).sort((a,b)=> b.date.localeCompare(a.date)).slice(0,lastN);
    if(!sessions.length) return null;
    let present=0, total=0;
    sessions.forEach(s=>{
      const st = s.records[studentId];
      if(st){ total++; if(st==="present") present++; else if(st==="late") present += 0.5; }
    });
    if(total===0) return null;
    return present/total;
  }

  function studentStatus(student){
    const rate = classAttendanceRate(student.id, student.classId, 4);
    if(rate===null) return "unknown";
    if(rate >= 0.8) return "green";
    if(rate >= 0.5) return "yellow";
    return "red";
  }

  // ---------------- needs-attention tracking ----------------
  const CHECKIN_STALE_DAYS = 21; // flag a student if no check-in logged in this many days

  function daysSince(dateStr){
    if(!dateStr) return null;
    const d = new Date(dateStr+"T00:00:00");
    const now = new Date(todayStr()+"T00:00:00");
    if(isNaN(d.getTime())) return null;
    return Math.round((now-d)/86400000);
  }

  function attentionReasons(s){
    const reasons = [];
    const status = studentStatus(s);
    if(status==="red") reasons.push("attendance is low");
    const li = lastInterviewDate(s.id);
    const days = li ? daysSince(li) : null;
    if(!li) reasons.push("no check-in logged yet");
    else if(days!==null && days>=CHECKIN_STALE_DAYS) reasons.push(`no check-in in ${days} days`);
    const missing = missingFields(s);
    if(missing.length) reasons.push("missing " + missing.join(", "));
    return reasons;
  }

  function attentionList(){
    return state.data.students.map(s=>({ student:s, status:studentStatus(s), reasons:attentionReasons(s), days:(lastInterviewDate(s.id)?daysSince(lastInterviewDate(s.id)):null) }))
      .filter(r=> r.reasons.length>0)
      .sort((a,b)=>{
        const aRed = a.status==="red" ? 0 : 1, bRed = b.status==="red" ? 0 : 1;
        if(aRed!==bRed) return aRed-bRed;
        const ad = a.days===null ? 9999 : a.days, bd = b.days===null ? 9999 : b.days;
        if(ad!==bd) return bd-ad;
        return a.student.name.localeCompare(b.student.name);
      });
  }

