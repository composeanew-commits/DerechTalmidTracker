<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Talmid Tracker" />
<title>Derech Talmid Tracker</title>
<style>
  :root{
    --paper:#F7F4EC; --card:#FFFFFF; --ink:#241D4A; --ink-soft:#6B6558; --line:#E4DFCF;
    --brand:#342B71; --brand-soft:#EDEBFA; --red:#A23B32; --red-bg:#F7E6E3;
    --amber:#B8791E; --amber-bg:#FBEFDD; --green:#47714B; --green-bg:#E7F0E6;
    --gray:#8B8779; --gray-bg:#EFEDE4;
    --serif: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);}
  #app{max-width:1040px;margin:0 auto;padding:20px 16px 90px;}
  .hidden{display:none !important;}

  .topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:wrap;
    position:sticky;top:env(safe-area-inset-top,0px);background:var(--paper);z-index:10;padding:6px 0;}
  .topbar h1{font-family:var(--serif);font-weight:400;font-size:24px;margin:0;color:var(--ink);}
  .pill{display:inline-flex;align-items:center;gap:6px;font-size:11px;padding:5px 10px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--ink-soft);}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--green);}
  .dot.off{background:var(--gray);}

  .tabs{display:flex;gap:6px;margin-bottom:16px;overflow-x:auto;padding-bottom:2px;}
  .tab{flex:none;padding:9px 16px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--ink-soft);font-size:13px;cursor:pointer;white-space:nowrap;}
  .tab.active{background:var(--brand);border-color:var(--brand);color:#fff;}

  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;}
  .panel + .panel{margin-top:14px;}
  .setup-title{font-family:var(--serif);font-size:22px;margin:0 0 4px;}
  .setup-desc{font-size:13px;color:var(--ink-soft);margin:0 0 18px;line-height:1.6;}
  .err{display:block;margin-top:12px;padding:10px 12px;background:#fdecea;color:#b3261e;border-radius:8px;font-size:13px;line-height:1.5;}

  label{display:block;font-size:12px;color:var(--ink-soft);margin:12px 0 5px;}
  label:first-child{margin-top:0;}
  input[type=text], input[type=password], input[type=date], select, textarea{
    width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:8px;font-size:15px;
    font-family:var(--sans);color:var(--ink);background:#FEFDFB;}
  input:focus, select:focus, textarea:focus{outline:2px solid var(--brand-soft);border-color:var(--brand);}
  textarea{resize:vertical;min-height:70px;}

  button{font-family:var(--sans);font-size:14px;cursor:pointer;border-radius:8px;padding:9px 14px;
    border:1px solid var(--line);background:var(--card);color:var(--ink);}
  button:hover{border-color:var(--ink-soft);}
  button.primary{background:var(--brand);border-color:var(--brand);color:#fff;}
  button.primary:hover{background:#291F5E;}
  button.danger{border-color:var(--red);color:var(--red);}
  button.ghost{border-color:transparent;background:transparent;padding:6px 8px;color:var(--ink-soft);}
  button.ghost:hover{color:var(--ink);}
  button:disabled{opacity:.5;cursor:default;}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
  .row-end{justify-content:flex-end;}
  .err{color:var(--red);font-size:13px;margin-top:10px;}
  .hint{color:var(--ink-soft);font-size:12px;margin-top:6px;line-height:1.5;}

  /* class chips */
  .class-strip{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
  .class-chip{padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:var(--card);font-size:13px;cursor:pointer;color:var(--ink-soft);}
  .class-chip.active{background:var(--brand);border-color:var(--brand);color:#fff;}
  .class-chip .n{opacity:.7;font-size:11px;margin-left:4px;}

  /* grid of students */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 10px;text-align:center;
    cursor:pointer;transition:border-color .12s ease,transform .12s ease;position:relative;}
  .card:hover{border-color:var(--ink-soft);transform:translateY(-1px);}
  .photo{width:60px;height:60px;border-radius:50%;margin:0 auto 8px;object-fit:cover;background:var(--brand-soft);
    display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:18px;color:var(--brand);
    border:3px solid var(--card);box-shadow:0 0 0 3px var(--ring,var(--gray));overflow:hidden;}
  .photo img{width:100%;height:100%;object-fit:cover;}
  .photo.red{--ring:var(--red);} .photo.yellow{--ring:var(--amber);} .photo.green{--ring:var(--green);}
  .name{font-family:var(--serif);font-size:14px;color:var(--ink);margin-bottom:3px;}
  .status-label{font-size:10px;padding:2px 8px;border-radius:999px;display:inline-block;}
  .status-label.red{background:var(--red-bg);color:var(--red);}
  .status-label.yellow{background:var(--amber-bg);color:var(--amber);}
  .status-label.green{background:var(--green-bg);color:var(--green);}
  .status-label.unknown{background:var(--gray-bg);color:var(--gray);}
  .empty{padding:50px 20px;text-align:center;color:var(--ink-soft);font-size:14px;}

  /* attendance rows */
  .att-row{display:flex;align-items:center;gap:10px;padding:10px 4px;border-bottom:1px solid var(--line);}
  .att-row:last-child{border-bottom:none;}
  .att-photo{width:38px;height:38px;border-radius:50%;background:var(--brand-soft);color:var(--brand);
    display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:13px;flex:none;overflow:hidden;}
  .att-photo img{width:100%;height:100%;object-fit:cover;}
  .att-name{flex:1;font-size:14px;}
  .seg{display:flex;gap:4px;}
  .seg button{padding:7px 10px;font-size:12px;border-radius:7px;}
  .seg button.p.active{background:var(--green);border-color:var(--green);color:#fff;}
  .seg button.l.active{background:var(--amber);border-color:var(--amber);color:#fff;}
  .seg button.a.active{background:var(--red);border-color:var(--red);color:#fff;}

  .hist-item{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;cursor:pointer;}
  .hist-item:last-child{border-bottom:none;}
  .hist-item:hover{color:var(--brand);}
  .hist-counts{color:var(--ink-soft);font-size:12px;}

  /* interviews */
  .student-picker{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;margin-bottom:14px;}
  .student-pill{flex:none;padding:7px 12px;border-radius:999px;border:1px solid var(--line);background:var(--card);font-size:13px;cursor:pointer;white-space:nowrap;}
  .student-pill.active{background:var(--brand);border-color:var(--brand);color:#fff;}
  .entry{border-bottom:1px solid var(--line);padding:12px 0;}
  .entry:last-child{border-bottom:none;}
  .entry-date{font-size:12px;color:var(--ink-soft);margin-bottom:4px;display:flex;justify-content:space-between;}
  .entry-notes{font-size:14px;white-space:pre-wrap;line-height:1.5;}

  /* drawer */
  .overlay{position:fixed;inset:0;background:rgba(36,29,74,.35);display:flex;justify-content:flex-end;z-index:50;}
  .drawer{width:min(440px,94vw);height:100%;background:var(--card);padding:22px 20px;overflow-y:auto;box-shadow:-8px 0 24px rgba(0,0,0,.08);
    padding-bottom:calc(22px + env(safe-area-inset-bottom,0px));}
  .drawer-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;}
  .drawer .photo{width:78px;height:78px;font-size:24px;margin:0 0 12px;}
  .drawer .name{font-size:19px;text-align:left;margin-bottom:2px;}
  .kv{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px;}
  .kv .k{color:var(--ink-soft);} .kv .v{color:var(--ink);text-align:right;}
  .thumb-input{margin-top:6px;}
  .rate-bar{height:6px;border-radius:3px;background:var(--gray-bg);overflow:hidden;margin-top:4px;}
  .rate-bar > div{height:100%;background:var(--green);}

  /* overview */
  .drawer-wide{width:min(920px,96vw);}
  .ov-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px;}
  .ov-toolbar input[type=text]{max-width:220px;}
  .ov-toolbar select{max-width:170px;}
  table.ov-table{width:100%;border-collapse:collapse;font-size:13px;}
  table.ov-table th{text-align:left;font-size:11px;color:var(--ink-soft);font-weight:500;padding:8px 8px;border-bottom:1px solid var(--line);}
  table.ov-table td{padding:8px 8px;border-bottom:1px solid var(--line);vertical-align:middle;}
  table.ov-table tr{cursor:pointer;}
  table.ov-table tr:hover td{background:var(--paper);}
  .ov-photo{width:30px;height:30px;border-radius:50%;background:var(--brand-soft);color:var(--brand);
    display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:11px;overflow:hidden;flex:none;}
  .ov-photo img{width:100%;height:100%;object-fit:cover;}
  .ov-name-cell{display:flex;align-items:center;gap:8px;}
  .ov-dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
  .ov-dot.red{background:var(--red);} .ov-dot.yellow{background:var(--amber);} .ov-dot.green{background:var(--green);} .ov-dot.unknown{background:var(--gray);}
  .link-btn{background:none;border:none;color:var(--brand);padding:0;font-size:13px;cursor:pointer;text-decoration:underline;}

  .card-sub{font-size:11px;color:var(--ink-soft);margin-bottom:8px;line-height:1.4;}
  .card-flag{position:absolute;top:8px;right:8px;width:9px;height:9px;border-radius:50%;background:var(--amber);
    border:2px solid var(--card);}
  .quick-call{position:absolute;top:8px;left:8px;width:24px;height:24px;border-radius:50%;background:var(--brand-soft);
    color:var(--brand);display:flex;align-items:center;justify-content:center;font-size:12px;text-decoration:none;line-height:1;}
  .ov-flag{color:var(--amber);font-size:11px;}

  /* attention banner */
  .attn-banner{background:var(--amber-bg);border:1px solid #eddcb0;border-radius:12px;margin-bottom:16px;overflow:hidden;}
  .attn-toggle{width:100%;display:flex;align-items:center;gap:10px;padding:12px 14px;background:none;border:none;
    cursor:pointer;text-align:left;color:var(--ink);}
  .attn-dot{width:8px;height:8px;border-radius:50%;background:var(--amber);flex:none;}
  .attn-toggle-text{flex:1;font-size:13px;font-weight:600;}
  .attn-toggle-sub{font-size:11px;color:var(--ink-soft);font-weight:400;margin-top:1px;}
  .attn-chevron{color:var(--ink-soft);font-size:11px;transition:transform .15s ease;}
  .attn-chevron.open{transform:rotate(180deg);}
  .attn-list{border-top:1px solid #eddcb0;padding:4px 8px;}
  .attn-row{display:flex;align-items:center;gap:10px;padding:8px 6px;border-bottom:1px solid #eddcb0;cursor:pointer;}
  .attn-row:last-child{border-bottom:none;}
  .attn-row:hover{background:rgba(255,255,255,.4);}
  .attn-row-photo{width:32px;height:32px;border-radius:50%;background:var(--card);color:var(--brand);flex:none;
    display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:11px;overflow:hidden;}
  .attn-row-photo img{width:100%;height:100%;object-fit:cover;}
  .attn-row-main{flex:1;min-width:0;}
  .attn-row-name{font-size:13px;color:var(--ink);}
  .attn-row-reason{font-size:11px;color:var(--ink-soft);}
  .attn-call{width:26px;height:26px;border-radius:50%;background:var(--card);color:var(--brand);flex:none;
    display:flex;align-items:center;justify-content:center;font-size:13px;text-decoration:none;}
  .attn-more{padding:10px 6px;font-size:12px;color:var(--brand);text-align:center;cursor:pointer;text-decoration:underline;}
</style>
</head>
<body>
<div id="app">

  <div class="topbar">
    <h1>Derech Talmid Tracker</h1>
    <div class="row" style="gap:8px;">
      <button class="link-btn hidden" id="overviewBtn">Full school overview</button>
      <div class="pill" id="connPill"><span class="dot off"></span><span id="connText">not connected</span></div>
      <button class="ghost" id="refreshBtn" title="Sync">&#8635;</button>
    </div>
  </div>

  <!-- SETUP VIEW -->
  <div id="setupView" class="panel">
    <p class="setup-title">Connect your data</p>
    <p class="setup-desc">This app is pre-configured to connect automatically. If you're seeing this screen, the automatic connection failed &mdash; check the error message below, then try again once your internet connection is stable.</p>
    <label for="sbUrl">Supabase URL</label>
    <input type="text" id="sbUrl" placeholder="https://xxxxx.supabase.co" />
    <label for="sbKey">Supabase anon / publishable key</label>
    <input type="password" id="sbKey" placeholder="eyJ... or sb_publishable_..." />
    <div class="row" style="margin-top:16px;">
      <button class="primary" id="connectBtn">Connect</button>
    </div>
    <span id="setupErr" class="err hidden"></span>
  </div>

  <!-- MAIN APP -->
  <div id="mainView" class="hidden">
    <div class="attn-banner hidden" id="attnBanner">
      <button class="attn-toggle" id="attnToggle">
        <span class="attn-dot"></span>
        <span class="attn-toggle-text" id="attnText">Loading\u2026<span class="attn-toggle-sub" id="attnSub"></span></span>
        <span class="attn-chevron open" id="attnChevron">&#9662;</span>
      </button>
      <div class="attn-list" id="attnList"></div>
    </div>
    <div class="tabs">
      <button class="tab active" data-tab="attendance">Attendance</button>
      <button class="tab" data-tab="interviews">Check-ins</button>
      <button class="tab" data-tab="roster">Classes &amp; Students</button>
    </div>

    <!-- ROSTER TAB -->
    <div id="tab-roster" class="hidden">
      <div class="class-strip" id="classStrip"></div>
      <div class="row" style="margin-bottom:14px;">
        <input type="text" id="rosterSearch" placeholder="Search students" style="max-width:220px;" />
        <div style="flex:1"></div>
        <button id="addClassBtn">+ Class</button>
        <button class="primary" id="addStudentBtn">+ Student</button>
      </div>
      <div class="grid" id="rosterGrid"></div>
      <div class="empty hidden" id="rosterEmpty">No students yet. Add a class, then add students.</div>
    </div>

    <!-- ATTENDANCE TAB -->
    <div id="tab-attendance">
      <div class="panel">
        <div class="row">
          <div style="flex:1;min-width:140px;">
            <label for="attClass">Class</label>
            <select id="attClass"></select>
            <p class="hint" id="attRoomHint"></p>
          </div>
          <div style="flex:1;min-width:140px;">
            <label for="attDate">Date</label>
            <input type="date" id="attDate" />
          </div>
        </div>
        <div id="attPhotoWrap" style="margin-top:12px;">
          <label>Photo of attendance sheet (optional)</label>
          <input type="file" id="attPhotoInput" accept="image/*" capture="environment" class="thumb-input" />
          <div id="attPhotoPreview" style="margin-top:8px;"></div>
        </div>
        <div id="attRows" style="margin-top:16px;"></div>
        <div class="row row-end" style="margin-top:14px;">
          <span id="attSummary" class="hint" style="margin-right:auto;"></span>
          <button class="primary" id="saveAttendance">Save attendance</button>
        </div>
      </div>
      <div class="panel">
        <p class="setup-title" style="font-size:16px;">History</p>
        <div id="attHistory"></div>
      </div>
    </div>

    <!-- INTERVIEWS TAB -->
    <div id="tab-interviews" class="hidden">
      <div class="student-picker" id="interviewPicker"></div>
      <div class="panel" id="interviewPanel">
        <div class="row">
          <p class="setup-title" style="font-size:16px;margin:0;flex:1;" id="interviewStudentName">Select a student</p>
          <button class="primary hidden" id="addEntryBtn">+ New entry</button>
        </div>
        <div id="entryForm" class="hidden" style="margin-top:12px;">
          <label for="entryDate">Date</label>
          <input type="date" id="entryDate" />
          <label for="entryNotes">Notes</label>
          <textarea id="entryNotes" placeholder="How is he doing? What did you talk about?"></textarea>
          <div class="row row-end" style="margin-top:10px;">
            <button class="ghost" id="cancelEntry">Cancel</button>
            <button class="primary" id="saveEntry">Save</button>
          </div>
        </div>
        <div id="entryList" style="margin-top:16px;"></div>
      </div>
    </div>
  </div>

</div>

<script>
  // Safety net: if ANYTHING in this page throws, show it on screen instead of failing silently.
  window.addEventListener("error", function(e){
    try{
      var el = document.getElementById("setupErr");
      var setup = document.getElementById("setupView");
      if(setup) setup.classList.remove("hidden");
      if(el){ el.textContent = "App error: " + (e.message || e); el.classList.remove("hidden"); }
    }catch(_){}
  });
  window.addEventListener("unhandledrejection", function(e){
    try{
      var el = document.getElementById("setupErr");
      var setup = document.getElementById("setupView");
      if(setup) setup.classList.remove("hidden");
      var msg = (e.reason && e.reason.message) ? e.reason.message : String(e.reason);
      if(el){ el.textContent = "App error: " + msg; el.classList.remove("hidden"); }
    }catch(_){}
  });
(function(){
  "use strict";

  // Pre-filled Supabase project (baked in so no setup step is needed on any device)
  const BUILT_IN_SUPABASE = {
    url: "https://fdzqakfwalpytzqpoitg.supabase.co",
    key: "sb_publishable_NblMIQhiVSdPjIHHVgxZIg_Wm8tDoOL"
  };

  const $ = id => document.getElementById(id);
  const state = { config:null, data:null, activeClass:null, activeInterviewStudent:null };

  const emptyData = () => ({ classes:[], students:[], attendance:[], interviews:[] });

  const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2,7);
  const todayStr = () => new Date().toISOString().slice(0,10);
  const escapeHtml = s => String(s==null?"":s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  const initials = name => (name||"?").split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0].toUpperCase()).join("");

  // ---------------- local persistence (per-device config) ----------------
  function loadLocal(key){ try{ const v = localStorage.getItem(key); return v ? JSON.parse(v) : null; }catch(e){ return null; } }
  function saveLocal(key, val){ try{ localStorage.setItem(key, JSON.stringify(val)); }catch(e){} }

  // ---------------- supabase ----------------
  function fetchWithTimeout(url, opts, ms){
    const ctrl = new AbortController();
    const timer = setTimeout(()=> ctrl.abort(), ms || 12000);
    return fetch(url, Object.assign({}, opts, { signal: ctrl.signal }))
      .finally(()=> clearTimeout(timer))
      .catch(e=>{
        if(e && e.name === "AbortError") throw new Error("Timed out reaching Supabase \u2014 check your internet connection and try again.");
        throw e;
      });
  }
  async function sbGet(path){
    const res = await fetchWithTimeout(`${state.config.url}/rest/v1/${path}`, {
      headers:{ apikey: state.config.key, Authorization: `Bearer ${state.config.key}` }
    });
    if(!res.ok) throw new Error(`${res.status} ${res.statusText} ${await res.text().catch(()=> "")}`.trim());
    return res.json();
  }
  async function sbUpsert(dataBlob){
    const res = await fetchWithTimeout(`${state.config.url}/rest/v1/derech_data?on_conflict=id`, {
      method:"POST",
      headers:{ apikey: state.config.key, Authorization: `Bearer ${state.config.key}`,
        "Content-Type":"application/json", "Prefer":"resolution=merge-duplicates" },
      body: JSON.stringify({ id:"main", data: dataBlob, updated_at: new Date().toISOString() })
    });
    if(!res.ok) throw new Error(`${res.status} ${res.statusText} ${await res.text().catch(()=> "")}`.trim());
  }
  async function persist(){ await sbUpsert(state.data); updateAttentionBanner(); }

  function setConn(on, label){
    $("connText").textContent = label;
    $("connPill").querySelector(".dot").classList.toggle("off", !on);
  }

  async function connect(cfg){
    state.config = cfg;
    setConn(false, "connecting\u2026");
    let rows;
    try{ rows = await sbGet("derech_data?select=data,updated_at&id=eq.main"); }
    catch(e){ setConn(false,"not connected"); throw e; }
    if(rows && rows.length){
      state.data = Object.assign(emptyData(), rows[0].data || {});
    } else {
      state.data = emptyData();
      await sbUpsert(state.data);
    }
    setConn(true, "connected");
    saveLocal("sb-config", cfg);
  }

  // ---------------- boot ----------------
  async function boot(){
    const saved = loadLocal("sb-config") || BUILT_IN_SUPABASE;
    $("sbUrl").value = saved.url; $("sbKey").value = saved.key;
    $("connectBtn").textContent = "Retry connection";
    setConn(false, "connecting\u2026");
    try{
      await connect(saved);
      showMain();
    }catch(e){
      showSetupError(e.message);
      setConn(false, "not connected");
    }
  }

  function showSetupError(msg){
    const el = $("setupErr");
    el.textContent = "Couldn't connect \u2014 " + msg;
    el.classList.remove("hidden");
  }

  function showMain(){
    $("setupView").classList.add("hidden");
    $("mainView").classList.remove("hidden");
    $("overviewBtn").classList.remove("hidden");
