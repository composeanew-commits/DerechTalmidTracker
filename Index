      pill.className = "student-pill" + (state.activeInterviewStudent===s.id ? " active":"");
      pill.textContent = s.name;
      pill.addEventListener("click", ()=>{ state.activeInterviewStudent = s.id; renderInterviewPanel(); renderInterviewPicker(); });
      wrap.appendChild(pill);
    });
    renderInterviewPanel();
  }

  function renderInterviewPanel(){
    const sid = state.activeInterviewStudent;
    const student = sid ? state.data.students.find(s=>s.id===sid) : null;
    $("interviewStudentName").textContent = student ? student.name : "Select a student";
    $("addEntryBtn").classList.toggle("hidden", !student);
    $("entryForm").classList.add("hidden");
    const list = $("entryList");
    list.innerHTML = "";
    if(!student){ list.innerHTML = '<p class="hint">Pick a student above to view or add interview notes.</p>'; return; }
    const entries = state.data.interviews.filter(i=>i.studentId===sid).sort((a,b)=> b.date.localeCompare(a.date));
    if(!entries.length){ list.innerHTML = '<p class="hint">No entries yet.</p>'; return; }
    entries.forEach(entry=>{
      const div = document.createElement("div");
      div.className = "entry";
      div.innerHTML = `<div class="entry-date"><span>${entry.date}</span><span><a href="#" data-del="${entry.id}" style="color:var(--red);font-size:12px;text-decoration:none;">delete</a></span></div>
        <div class="entry-notes">${escapeHtml(entry.notes)}</div>`;
      div.querySelector("[data-del]").addEventListener("click", async e=>{
        e.preventDefault();
        if(!confirm("Delete this entry?")) return;
        state.data.interviews = state.data.interviews.filter(i=>i.id!==entry.id);
        await persist(); renderInterviewPanel();
      });
      list.appendChild(div);
    });
  }

  $("addEntryBtn").addEventListener("click", ()=>{
    $("entryDate").value = todayStr();
    $("entryNotes").value = "";
    $("entryForm").classList.remove("hidden");
  });
  $("cancelEntry").addEventListener("click", ()=> $("entryForm").classList.add("hidden"));
  $("saveEntry").addEventListener("click", async ()=>{
    const notes = $("entryNotes").value.trim();
    if(!notes) { alert("Add some notes first."); return; }
    state.data.interviews.push({ id:uid(), studentId: state.activeInterviewStudent, date: $("entryDate").value || todayStr(), notes });
    $("saveEntry").disabled = true;
    try{ await persist(); $("entryForm").classList.add("hidden"); renderInterviewPanel(); }
    catch(e){ alert("Couldn't save: " + e.message); }
    finally{ $("saveEntry").disabled = false; }
  });

  // ================= FULL SCHOOL OVERVIEW =================
  let ovOverlay = null;
  let ovFilter = { text:"", status:"all" };

  function lastInterviewDate(studentId){
    const entries = state.data.interviews.filter(i=>i.studentId===studentId).sort((a,b)=> b.date.localeCompare(a.date));
    return entries.length ? entries[0].date : "";
  }

  function openOverview(){
    ovOverlay = document.createElement("div");
    ovOverlay.className = "overlay";
    ovOverlay.addEventListener("click", e=>{ if(e.target===ovOverlay){ ovOverlay.remove(); ovOverlay=null; } });
    ovOverlay.innerHTML = `
      <div class="drawer drawer-wide">
        <div class="drawer-head">
          <p class="setup-title" style="font-size:20px;margin:0;">Full school overview</p>
          <button class="ghost" id="closeOverview">Close</button>
        </div>
        <div class="ov-toolbar">
          <input type="text" id="ovSearch" placeholder="Search name" />
          <select id="ovStatusFilter">
            <option value="all">All statuses</option>
            <option value="attention">\u26a0 Needs attention (any reason)</option>
            <option value="red">Low attendance</option>
            <option value="yellow">Keep an eye on</option>
            <option value="green">Doing great</option>
            <option value="unknown">No attendance data yet</option>
            <option value="missing">Missing contact info</option>
            <option value="stale">No recent check-in</option>
          </select>
          <div style="flex:1"></div>
          <button class="primary" id="exportCsvBtn">Download as CSV</button>
        </div>
        <p class="hint" id="ovMissingSummary"></p>
        <div style="overflow-x:auto;">
          <table class="ov-table" id="ovTable">
            <thead><tr><th></th><th>Name</th><th>Shiur</th><th>Room</th><th>Phone</th><th>Parent phone</th><th>Attendance</th><th>Last check-in</th><th></th></tr></thead>
            <tbody id="ovTbody"></tbody>
          </table>
        </div>
        <p class="hint" id="ovEmpty" class="hidden"></p>
      </div>
    `;
    document.body.appendChild(ovOverlay);
    ovOverlay.querySelector("#closeOverview").addEventListener("click", ()=>{ ovOverlay.remove(); ovOverlay=null; });
    ovOverlay.querySelector("#ovSearch").addEventListener("input", e=>{ ovFilter.text = e.target.value.toLowerCase(); renderOverviewRows(); });
    ovOverlay.querySelector("#ovStatusFilter").addEventListener("change", e=>{ ovFilter.status = e.target.value; renderOverviewRows(); });
    ovOverlay.querySelector("#exportCsvBtn").addEventListener("click", exportOverviewCsv);
    renderOverviewRows();
  }

  function overviewRows(){
    return state.data.students.map(s=>{
      const cls = s.classId ? classById(s.classId) : null;
      const status = studentStatus(s);
      const rate = s.classId ? classAttendanceRate(s.id, s.classId, 8) : null;
      const lastInterview = lastInterviewDate(s.id);
      const checkinDays = lastInterview ? daysSince(lastInterview) : null;
      const stale = !lastInterview || (checkinDays!==null && checkinDays>=CHECKIN_STALE_DAYS);
      return { student:s, cls, status, rate, lastInterview, checkinDays, stale, missing: missingFields(s), reasons: attentionReasons(s) };
    }).filter(r=>{
      if(ovFilter.text && !r.student.name.toLowerCase().includes(ovFilter.text)) return false;
      if(ovFilter.status === "missing") return r.missing.length > 0;
      if(ovFilter.status === "stale") return r.stale;
      if(ovFilter.status === "attention") return r.reasons.length > 0;
      if(ovFilter.status !== "all") return r.status === ovFilter.status;
      return true;
    }).sort((a,b)=> STATUS_ORDER_OV[a.status]-STATUS_ORDER_OV[b.status] || a.student.name.localeCompare(b.student.name));
  }
  const STATUS_ORDER_OV = { red:0, yellow:1, unknown:2, green:3 };

  function renderOverviewRows(){
    if(!ovOverlay) return;
    const rows = overviewRows();
    const tbody = ovOverlay.querySelector("#ovTbody");
    tbody.innerHTML = "";
    rows.forEach(r=>{
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td><span class="ov-dot ${r.status}"></span></td>
        <td><div class="ov-name-cell"><div class="ov-photo">${r.student.photo?`<img src="${r.student.photo}" alt="">`:initials(r.student.name)}</div>${escapeHtml(r.student.name)}</div></td>
        <td>${r.cls ? escapeHtml(r.cls.name) : "\u2014"}</td>
        <td>${r.cls && r.cls.room ? escapeHtml(r.cls.room) : "\u2014"}</td>
        <td>${r.student.phone ? `<a href="tel:${escapeHtml(r.student.phone)}" onclick="event.stopPropagation()" class="link-btn">${escapeHtml(r.student.phone)}</a>` : "\u2014"}</td>
        <td>${r.student.parentPhone ? `<a href="tel:${escapeHtml(r.student.parentPhone)}" onclick="event.stopPropagation()" class="link-btn">${escapeHtml(r.student.parentPhone)}</a>` : "\u2014"}</td>
        <td>${r.rate===null ? "\u2014" : Math.round(r.rate*100)+"%"}</td>
        <td>${r.lastInterview ? escapeHtml(r.lastInterview) + (r.stale ? ` <span class="ov-flag">(${r.checkinDays}d ago)</span>` : ` <span class="hint">(${r.checkinDays}d ago)</span>`) : `<span class="ov-flag">Never</span>`}</td>
        <td>${r.missing.length ? `<span class="ov-flag" title="Missing: ${escapeHtml(r.missing.join(', '))}">&#9888; ${r.missing.length}</span>` : ""}</td>
      `;
      tr.addEventListener("click", ()=> openStudentDrawer(r.student.id));
      tbody.appendChild(tr);
    });
    const empty = ovOverlay.querySelector("#ovEmpty");
    if(!rows.length){ empty.textContent = "No students match."; empty.classList.remove("hidden"); }
    else empty.classList.add("hidden");
    const missingCount = state.data.students.filter(s=> missingFields(s).length>0).length;
    const attentionCount = attentionList().length;
    const summaryEl = ovOverlay.querySelector("#ovMissingSummary");
    summaryEl.textContent = `${state.data.students.length} student${state.data.students.length===1?"":"s"} total \u00b7 ${attentionCount} need attention \u00b7 ${missingCount} missing a shiur, room, or phone number.`;
  }

  async function exportOverviewCsv(){
    const rows = overviewRows();
    const header = ["Name","Shiur","Room","Status","Attendance % (last 8)","Student phone","Parent phone","Last check-in date","Days since check-in","Missing info","Needs attention because"];
    const lines = [header.map(csvEscape).join(",")];
    rows.forEach(r=>{
      lines.push([
        r.student.name,
        r.cls ? r.cls.name : "",
        r.cls && r.cls.room ? r.cls.room : "",
        r.status,
        r.rate===null ? "" : Math.round(r.rate*100),
        r.student.phone||"",
        r.student.parentPhone||"",
        r.lastInterview||"",
        r.checkinDays===null ? "" : r.checkinDays,
        r.missing.join("; "),
        r.reasons.join("; ")
      ].map(csvEscape).join(","));
    });
    const csv = lines.join("\n");
    try{
      await saveFile(`school-overview-${todayStr()}.csv`, "text/csv", csv);
    }catch(e){
      if(e && e.code !== "declined") alert("Couldn't download: " + (e.message||e.code||e));
    }
  }

  $("overviewBtn").addEventListener("click", openOverview);

  boot();
})();
</script>
</body>
</html>
